{
  "name": "chessapp",
  "private": true,
  "version": "0.1.0",
  "description": "Local 3D fantasy chess for Mac and browser",
  "author": "Chris Pearce",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/verify-dependencies.mjs",
    "predev": "node scripts/verify-dependencies.mjs",
    "predev:app": "node scripts/verify-dependencies.mjs",
    "prebuild": "node scripts/verify-dependencies.mjs",
    "dev": "vite",
    "dev:app": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && VITE_BASE_PATH=/chessApp/ vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint",
    "pack:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "chess.js": "^1.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.cpearce.fantasychess3d",
    "productName": "Fantasy Chess 3D",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Fantasy-Chess-3D-${version}-mac.${ext}"
    }
  }
}
